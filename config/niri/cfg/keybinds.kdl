binds {

	// ────────────── Keybindings ──────────────
	// https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

	// ─── noctalia-shell keybinds ───
	// https://docs.noctalia.dev/getting-started/keybinds/

	Mod+Shift+Slash { show-hotkey-overlay; }

	// ─── Noctalia ───
	// See available: qs -c noctalia-shell ipc show
	Mod+S hotkey-overlay-title="Toggle Noctalia Settings" { spawn-sh "qs -c noctalia-shell ipc call settings toggle"; }
	Mod+P hotkey-overlay-title="Cycle Power Profile" { spawn-sh "qs -c noctalia-shell ipc call powerProfile cycle"; }
	Mod+Comma hotkey-overlay-title="Dismiss Notifications						( <span background=\"#303030\"><tt>+Shift</tt></span>: Clear )" { spawn-sh "qs -c noctalia-shell ipc call notifications dismissAll"; }
	Mod+Shift+Comma hotkey-overlay-title=null { spawn-sh "qs -c noctalia-shell ipc call notifications clear && qs -c noctalia-shell ipc call notifications dismissAll"; }
	Mod+Shift+Space hotkey-overlay-title="Toggle Noctalia Bar" { spawn-sh "qs -c noctalia-shell ipc call bar toggle"; }
	Mod+Ctrl+Space hotkey-overlay-title="Random Wallpaper" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh random"; }
	Mod+Shift+U hotkey-overlay-title="<b>Update Feathers and Flame</b>" { spawn-sh "alacritty --class=com.serpentdagger.feathers-update -e bash /home/serpent/.local/share/feathers-and-flame/update.sh"; }
	Mod+V hotkey-overlay-title="Activate Screensaver						( <span background=\"#303030\"><tt>+Shift</tt></span>: Current Monitor,  <span background=\"#303030\"><tt>+Alt</tt></span>: Toggle Active )" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/screensaver.sh force"; }
	Mod+Shift+V hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/screensaver.sh force --current"; }
	Mod+Alt+V hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/helpers/state.sh toggle 'screensaver_disabled' --notify"; }
	Mod+Shift+Ctrl+Q hotkey-overlay-title="<b>Restart Noctalia</b>" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/noctalia-restart.sh"; }
	// Mod+Ctrl+Space hotkey-overlay-title="Random Background" { spawn-sh "qs -c noctalia-shell ipc call wallpaper random $(niri msg focused-output | grep -Po \"Output.*\\(\\K[^\\)]+\")"; }
	// Mod+Shift+1 { spawn-sh "qs -c noctalia-shell ipc call wallpaper set /home/serpent/.local/share/feathers-and-flame/wallpaper-presets/1.* $(niri msg focused-output | grep -Po \"Output.*\\(\\K[^\\)]+\")"; }
	Mod+Shift+1 hotkey-overlay-title="Wallpaper Favourite 1					( <span background=\"#303030\"><tt>Numbers</tt></span> )" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 1"; }
	Mod+Shift+2 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 2"; }
	Mod+Shift+3 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 3"; }
	Mod+Shift+4 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 4"; }
	Mod+Shift+5 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 5"; }
	Mod+Shift+6 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 6"; }
	Mod+Shift+7 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 7"; }
	Mod+Shift+8 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 8"; }
	Mod+Shift+9 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 9"; }
	Mod+Shift+0 hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/wallpaper.sh preset 0"; }
	Mod+Shift+W hotkey-overlay-title=null { spawn-sh "qs -c noctalia-shell ipc call settings toggleTab wallpaper"; }
	Mod+Shift+N hotkey-overlay-title="Toggle Night-Light" { spawn-sh "niri msg action do-screen-transition && qs -c noctalia-shell ipc call nightLight toggle"; }

	// ─── Hot-Rules ───
	Mod+Alt+D hotkey-overlay-title="Toggle laptop-monitor on/off" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/hot-rules.sh hdmi-only"; }
	Mod+Alt+T hotkey-overlay-title="Toggle global transparency" { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/hot-rules.sh transparency"; }
	Mod+Alt+P hotkey-overlay-title=null { spawn-sh "bash /home/serpent/.local/share/feathers-and-flame/script/cmd/hot-rules.sh tablet-to-hdmi"; }

	// ─── Applications ───
	Mod+Return                          hotkey-overlay-title="Open Terminal" { spawn "alacritty"; }
	Mod+Space                           hotkey-overlay-title="<b>Open App Launcher</b>" { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
	Mod+B                               hotkey-overlay-title="Open Browser							( <span background=\"#303030\"><tt>+Shift</tt></span>: Private )" { spawn "~/.local/share/applications/start-mullvad-browser.desktop"; }
	Mod+Shift+B                         hotkey-overlay-title=null { spawn "~/.local/share/applications/start-tor-browser.desktop"; }
	Mod+Shift+O                         hotkey-overlay-title="Lock Screen" { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
	Mod+Escape                          repeat=false hotkey-overlay-title="Session Menu" { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
	Mod+G                               hotkey-overlay-title="Open Gimp" { spawn "gimp"; }
	// Mod+Shift+G 															hotkey-overlay-title="Open Krita" { spawn "krita"; }
	Mod+Y																hotkey-overlay-title="Open FreeTube YT-viewer" { spawn "freetube"; }

	Mod+E                               hotkey-overlay-title="File Manager							( <span background=\"#303030\"><tt>+Shift</tt></span>: Starred )" { spawn-sh "nautilus"; }
	Mod+Shift+E													hotkey-overlay-title=null { spawn-sh "nautilus starred:///"; }
	Mod+Shift+C                         hotkey-overlay-title="<b>System Monitor</b>							( <span background=\"#303030\"><tt>I</tt></span>: Internet,  <span background=\"#303030\"><tt>G</tt></span>: GPU )" { spawn-sh "alacritty -e btop"; }
	Mod+Shift+I                         hotkey-overlay-title=null { spawn-sh "alacritty -e nethogs -d 0.2"; }
	Mod+Shift+G                         hotkey-overlay-title=null { spawn-sh "alacritty -e nvtop"; }
	xF86Calculator { spawn-sh "gnome-calculator"; }
	// Mod+Shift+I                         hotkey-overlay-title="Install Package" { spawn-sh "alacritty -e bash /home/serpent/.local/share/feathers-and-flame/script/triggers/pkg_install.sh"; }
	Mod+N																hotkey-overlay-title="Open LazyVim" { spawn-sh "alacritty -e nvim"; }
	Mod+Ctrl+S													hotkey-overlay-title="LocalSend Share File						( <span background=\"#303030\"><tt>Shift</tt></span>: Folder,  <span background=\"#303030\"><tt>Alt</tt></span>: Clipboard )" { spawn-sh "alacritty -e bash ~/.local/share/feathers-and-flame/script/cmd/share.sh file"; }
	Mod+Shift+S													hotkey-overlay-title=null { spawn-sh "alacritty -e bash ~/.local/share/feathers-and-flame/script/cmd/share.sh folder"; }
	Mod+Alt+S														hotkey-overlay-title=null { spawn-sh "alacritty -e bash ~/.local/share/feathers-and-flame/script/cmd/share.sh clipboard"; }

	// ─── Media Controls ───
	XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume increase"; }
	XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume decrease"; }
	XF86AudioMute                       allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteOutput"; }
	XF86AudioMicMute                    allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteInput"; }
	XF86AudioNext                       allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media next"; }
	XF86AudioPrev                       allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media previous"; }
	XF86AudioPlay                       allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }
	XF86AudioPause                      allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }

	// ─── Brightness Controls ───
	XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness increase"; }
	XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness decrease"; }

	// ─── Window Movement and Focus ───
	//	Mod+Shift+W                         { spawn-sh "alacritty -e niri msg pick-window && sleep 2"; }
	Mod+W                               { close-window; }
	Mod+O                               repeat=false { toggle-overview; }
	Mod+M																repeat=false hotkey-overlay-title="Mirror Focused Monitor" { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }

	Mod+Left                            hotkey-overlay-title="Switch Focus							( <span background=\"#303030\"><tt>Arrows</tt></span>, <span background=\"#303030\"><tt>HJKL</tt></span> )" { focus-column-or-monitor-left; }
	Mod+H                               { focus-column-or-monitor-left; }
	Mod+Right                           { focus-column-or-monitor-right; }
	Mod+L                               { focus-column-or-monitor-right; }
	Mod+Up                              { focus-window-or-workspace-up; }
	Mod+K                               { focus-window-or-workspace-up; }
	Mod+Down                            { focus-window-or-workspace-down; }
	Mod+J                               { focus-window-or-workspace-down; }

	Mod+CTRL+Left                       hotkey-overlay-title="Move Focused							( <span background=\"#303030\"><tt>Arrows</tt></span>, <span background=\"#303030\"><tt>HJKL</tt></span> )" { move-column-left-or-to-monitor-left; }
	Mod+CTRL+H                          { move-column-left-or-to-monitor-left; }
	Mod+CTRL+Right                      { move-column-right-or-to-monitor-right; }
	Mod+CTRL+L                          { move-column-right-or-to-monitor-right; }
	Mod+CTRL+UP                         { move-window-up-or-to-workspace-up; }
	Mod+CTRL+K                          { move-window-up-or-to-workspace-up; }
	Mod+CTRL+Down                       { move-window-down-or-to-workspace-down; }
	Mod+CTRL+J                          { move-window-down-or-to-workspace-down; }

	Mod+BracketLeft  hotkey-overlay-title="Consume or Expell Window Left			(  <span background=\"#303030\"><tt>]</tt></span>: Right )" { consume-or-expel-window-left; }
	Mod+BracketRight hotkey-overlay-title=null { consume-or-expel-window-right; }
	Mod+Backslash  hotkey-overlay-title="Consume Window Into Column			( <span background=\"#303030\"><tt>+Shift</tt></span>: Expell )" { consume-window-into-column; }
	Mod+Shift+Backslash { expel-window-from-column; }

	Mod+Home                            { focus-column-first; }
	Mod+End                             { focus-column-last; }
	Mod+CTRL+Home                       { move-column-to-first; }
	Mod+CTRL+End                        { move-column-to-last; }

	Mod+Shift+Left                      { focus-monitor-left; }
	Mod+Shift+Right                     { focus-monitor-right; }
	Mod+Shift+UP                        { focus-monitor-up; }
	Mod+Shift+Down                      { focus-monitor-down; }
	Mod+Shift+H                         { focus-monitor-left; }
	Mod+Shift+L                         { focus-monitor-right; }
	Mod+Shift+K                         { focus-monitor-up; }
	Mod+Shift+J                         { focus-monitor-down; }

	Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
	Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
	Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
	Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
	Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
	Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
	Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
	Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

	Mod+Shift+Ctrl+Alt+Down hotkey-overlay-title="Move Focused Workspace Down			( <span background=\"#303030\"><tt>Arrows</tt></span>, <span background=\"#303030\"><tt>HJKL</tt></span> )" { move-workspace-to-monitor-down; }
	Mod+Shift+Ctrl+Alt+Up { move-workspace-to-monitor-up; }
	Mod+Shift+Ctrl+Alt+Left { move-workspace-to-monitor-left; }
	Mod+Shift+Ctrl+Alt+Right { move-workspace-to-monitor-right; }
	Mod+Shift+Ctrl+Alt+J { move-workspace-to-monitor-down; }
	Mod+Shift+Ctrl+Alt+K { move-workspace-to-monitor-up; }
	Mod+Shift+Ctrl+Alt+H { move-workspace-to-monitor-left; }
	Mod+Shift+Ctrl+Alt+L { move-workspace-to-monitor-right; }

	// Alternatively, there are commands to move just a single window:
	// Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
	// And you can also move a whole workspace to another monitor:
	// Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }

	// ─── Workspace Switching ───
	Mod+WheelScrollDown                 hotkey-overlay-title="Switch Workspace Down					( <span background=\"#303030\"><tt>Up</tt></span>, <span background=\"#303030\"><tt>Left</tt></span>, <span background=\"#303030\"><tt>Right</tt></span> )" cooldown-ms=150 { focus-workspace-down; }
	Mod+WheelScrollUp                   hotkey-overlay-title=null cooldown-ms=150 { focus-workspace-up; }
	Mod+CTRL+WheelScrollDown            hotkey-overlay-title="Move Column to Workspace Down			( <span background=\"#303030\"><tt>Up</tt></span>, <span background=\"#303030\"><tt>Left</tt></span>, <span background=\"#303030\"><tt>Right</tt></span> )" cooldown-ms=150 { move-column-to-workspace-down; }
	Mod+CTRL+WheelScrollUp              hotkey-overlay-title=null cooldown-ms=150 { move-column-to-workspace-up; }

	Mod+WheelScrollRight                hotkey-overlay-title=null { focus-column-right; }
	Mod+WheelScrollLeft                 { focus-column-left; }
	Mod+CTRL+WheelScrollRight           hotkey-overlay-title=null { move-column-right; }
	Mod+CTRL+WheelScrollLeft            { move-column-left; }

	Mod+Shift+WheelScrollDown           { focus-column-right; }
	Mod+Shift+WheelScrollUp             hotkey-overlay-title=null { focus-column-left; }
	Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
	Mod+CTRL+Shift+WheelScrollUp        hotkey-overlay-title=null { move-column-left; }

	Mod+1                               hotkey-overlay-title="Switch to Workspace 1					( <span background=\"#303030\"><tt>Numbers</tt></span> )" { focus-workspace 1; }
	Mod+2                               { focus-workspace 2; }
	Mod+3                               { focus-workspace 3; }
	Mod+4                               { focus-workspace 4; }
	Mod+5                               { focus-workspace 5; }
	Mod+6                               { focus-workspace 6; }
	Mod+7                               { focus-workspace 7; }
	Mod+8                               { focus-workspace 8; }
	Mod+9                               { focus-workspace 9; }

	Mod+CTRL+1                          hotkey-overlay-title="Move Columnt to Workspace 1			( <span background=\"#303030\"><tt>Numbers</tt></span> )" { move-column-to-workspace 1; }
	Mod+CTRL+2                          { move-column-to-workspace 2; }
	Mod+CTRL+3                          { move-column-to-workspace 3; }
	Mod+CTRL+4                          { move-column-to-workspace 4; }
	Mod+CTRL+5                          { move-column-to-workspace 5; }
	Mod+CTRL+6                          { move-column-to-workspace 6; }
	Mod+CTRL+7                          { move-column-to-workspace 7; }
	Mod+CTRL+8                          { move-column-to-workspace 8; }
	Mod+CTRL+9                          { move-column-to-workspace 9; }

	Mod+TAB                             hotkey-overlay-title="Switch to Previous Workspace" { focus-workspace-previous; }

	// ─── Layout Controls ───
	Mod+F                               { maximize-column; }
	Mod+R { switch-preset-column-width; }
	Mod+Shift+R { switch-preset-window-height; }
	Mod+C                               { center-column; }
	Mod+CTRL+C                          { center-visible-columns; }
	Mod+Minus                           { set-column-width "-10%"; }
	Mod+Equal                           { set-column-width "+10%"; }
	Mod+Shift+Minus                     { set-window-height "-10%"; }
	Mod+Shift+Equal                     { set-window-height "+10%"; }


	// ─── Modes ───
	Mod+Ctrl+T                               { toggle-window-floating; }
	Mod+T                         { switch-focus-between-floating-and-tiling; }
	Mod+Shift+F                         hotkey-overlay-title="Fullscreen Window" { fullscreen-window; }
	Mod+Q                               { toggle-column-tabbed-display; }

	// ─── Screenshots ───
	Print hotkey-overlay-title="Take a Screenshot						( <span background=\"#303030\"><tt>+Ctrl</tt></span>: Screen,  <span background=\"#303030\"><tt>+Alt</tt></span>: Window )" { screenshot; }
	Ctrl+Print { screenshot-screen; }
	Alt+Print { screenshot-window; }

	// ─── Emergency Escape Key ───
	// Use this when a fullscreen app blocks your keybinds.
	// It disables any active keyboard shortcut inhibitor, restoring control.
	Mod+Shift+Q                          hotkey-overlay-title="<b>Reclaim Keyboard Control</b>" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

	// ─── Exit / Power ───
	CTRL+ALT+Delete                     { quit; } // Also quits Niri
	Mod+Shift+P                         hotkey-overlay-title="Power Off Moniters" { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
}
